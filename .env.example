# Copy to .env locally; never commit real credentials.
SERVERPOD_RUN_MODE=development
DATABASE_PROVIDER=docker
DATABASE_HOST=localhost
DATABASE_PORT=8090
DATABASE_NAME=equip_link
DATABASE_USER=postgres
# Used by both local Docker Compose PostgreSQL and the server.
POSTGRES_PASSWORD=
# Local Docker Compose Redis credentials.
REDIS_PROVIDER=docker
REDIS_PASSWORD=
POSTGRES_TEST_PASSWORD=
REDIS_TEST_PASSWORD=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=EquipLink
# Paste the downloaded Google Web OAuth client JSON; keep it private.
GOOGLE_CLIENT_SECRET_JSON=
# Local APK build only; fill after Cloud deploy prints the API URL.
EQUIPLINK_API_URL=
# Public Web OAuth client ID used when building the Flutter APK.
GOOGLE_SERVER_CLIENT_ID=
