# ==============================================================================
# EquipLink Environment Configuration Template (.env.example)
#
# Copy this file to `.env` in the workspace root or `equip_link_server/.env`.
# NEVER commit real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Serverpod Server Configuration
# ------------------------------------------------------------------------------
SERVERPOD_RUN_MODE=development
SERVERPOD_APPLY_MIGRATIONS=false

# ------------------------------------------------------------------------------
# 2. Database Provider Selection & Configuration
# Options:
#   - `neon`     : External Neon Serverless PostgreSQL (requires SSL)
#   - `docker`   : Local Docker Compose PostgreSQL (default port 8090)
#   - `embedded` : Local embedded Serverpod PostgreSQL (default development.yaml)
#   - `custom`   : Custom PostgreSQL instance
# ------------------------------------------------------------------------------
DATABASE_PROVIDER=neon

# Database connection string:
# Use the direct Neon endpoint (port 5432) for migrations.
# URL-encode reserved characters in the username or password.
DATABASE_URL=postgresql://neondb_owner:your_database_password_here@ep-your-project-id.region.aws.neon.tech:5432/equip_link?sslmode=require

# ------------------------------------------------------------------------------
# 3. Redis Provider Selection & Configuration
# Options:
#   - `upstash` : External Upstash Serverless Redis (standard TCP over TLS)
#   - `docker`  : Local Docker Compose Redis (default port 8091)
#   - `none`    : Redis disabled (Serverpod in-memory cache)
#   - `custom`  : Custom Redis instance
# ------------------------------------------------------------------------------
REDIS_PROVIDER=upstash

# Redis connection string:
# `rediss://` enables TLS; use `redis://` for local Docker Redis.
REDIS_URL=rediss://default:your_upstash_password_here@your-upstash-endpoint.upstash.io:6379

# ------------------------------------------------------------------------------
# 4. Brevo Transactional Email (Backend Secret)
# Used for verification codes, password resets, and user invites.
# Keep strictly server-side. Never expose to client applications.
# ------------------------------------------------------------------------------
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=EquipLink Support
# Optional: Brevo transactional template ID for OTP/verification emails
# BREVO_TEMPLATE_ID=1

# ------------------------------------------------------------------------------
# 5. Google OAuth / Serverpod Identity Provider (Backend Secret)
#
# This must be the OAuth WEB client secret JSON consumed by Serverpod's
# GoogleIdpConfigFromPasswords. Keep it server-side. Do not add it to Flutter,
# Android resources, Dart defines, or frontend assets.
#
# The SERVERPOD_PASSWORD_ form is the supported environment override for the
# matching key (`googleClientSecret`) in config/passwords.yaml.
# Escape/quote the JSON according to the shell or secret manager being used.
SERVERPOD_PASSWORD_googleClientSecret={"web":{"client_id":"...apps.googleusercontent.com","client_secret":"...","redirect_uris":["http://localhost:8080/auth/google/callback"]}}

# Android OAuth client metadata is not a secret and is configured in Google
# Cloud Console. For the local debug build, use:
#   Package name: com.example.equip_link_flutter
#   SHA-1: 46:3C:AA:C6:CD:17:C7:DF:8E:F8:D2:CA:20:93:BD:39:85:89:9B:24
# Release builds require a separate release certificate SHA-1.

# ------------------------------------------------------------------------------
# 6. Common Provider Combinations:
#
# [Option A: External Cloud - Neon + Upstash]
#   DATABASE_PROVIDER=neon
#   DATABASE_URL=postgresql://neondb_owner:...@ep-xyz.region.aws.neon.tech:5432/equip_link?sslmode=require
#   REDIS_PROVIDER=upstash
#   REDIS_URL=rediss://default:...@xyz.upstash.io:6379
#
# [Option B: Local Self-Hosted - Docker PostgreSQL + Docker Redis]
#   DATABASE_PROVIDER=docker
#   DATABASE_URL=postgresql://postgres:P4XPVyxNWTGhYe-56gqqzbeMqwPKU3lF@localhost:8090/equip_link
#   REDIS_PROVIDER=docker
#   REDIS_URL=redis://:jjgPe30wriYvj438PSlHTbuM9uTWBi51@localhost:8091
#
# [Option C: Hybrid - Neon PostgreSQL + Docker Redis]
#   DATABASE_PROVIDER=neon
#   DATABASE_URL=postgresql://neondb_owner:...@ep-xyz.region.aws.neon.tech:5432/equip_link?sslmode=require
#   REDIS_PROVIDER=docker
#   REDIS_URL=redis://:password@localhost:8091
# ------------------------------------------------------------------------------
